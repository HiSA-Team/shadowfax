!/README.md
!/SETUP.md
!/DEBUG.md
!/platform
!/requirements.txt
!/rust-toolchain.toml
!/scripts
!/shadowfax
!/test
!/tsm
!/video

# Experiments: keep the scientific results (CSV), the analysis scripts and the
# protocol READMEs; logs, plots and per-size device trees stay local.
!/experiments/
/experiments/**
!/experiments/**/
!/experiments/**/*.csv
!/experiments/**/*.pdf
!/experiments/**/*.py
!/experiments/**/README.md
