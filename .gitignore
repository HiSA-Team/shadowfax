*.o
/**/keys
/**/__pycache__

# Exclude everything except these folders in root
/*
!/.devcontainer
!/.dockerignore
!/.github
!/.gitignore
!/.pre-commit-config.yaml
!/common
!/config.mk
!/Cargo.lock
!/Cargo.toml
!/docs
!/Dockerfile
